local function resolveTheme(name, overrides)
	local out = {}
	for k, hex in pairs(Themes[name]) do
		out[k] = parseColor(hex)
	end
	for k, c in pairs(overrides or {}) do
		out[k] = c
	end
	return out
end

----------------------------------------------------------------------
-- 4. DRAWING RENDERER  (retained mode, pooled, change-only writes)
----------------------------------------------------------------------

local function newGroup(parent)
	local g = { hidden = false, parent = parent, nodes = {}, children = {} }
	if parent then
		table.insert(parent.children, g)
	end
	return g
end

local function groupHidden(g)
	while g do
		if g.hidden then
			return true
		end
		g = g.parent
	end
	return false
end

local Node = {}
Node.__index = Node

-- writes a Drawing property only when the value changed
function Node:_prop(prop, value)
	local cache = self.cache
	if cache[prop] ~= value then
		cache[prop] = value
		self.obj[prop] = value
	end
end

function Node:_flush()
	local r = self.renderer
	if r.destroyed then
		return
	end
	local vis = self.shown and r.visible and not groupHidden(self.group)
	if not vis then
		self:_prop("Visible", false)
		return
	end
	local ox = self.absolute and 0 or r.ox
	local oy = self.absolute and 0 or r.oy
	self:_prop("Position", Vector2.new(math.floor(ox + self.lx + 0.5), math.floor(oy + self.ly + 0.5)))
	if self.kind == "Rect" or self.kind == "Image" then
		self:_prop("Size", Vector2.new(self.w, self.h))
	end
	self:_prop("Visible", true)
end

function Node:Move(x, y)
	if self.align == "right" then
		self.ax = x
		self.lx = x - self.renderer:TextWidth(self.text or "", self.size)
	else
		self.lx = x
	end
	self.ly = y
	self:_flush()
end

function Node:Resize(w, h)
	self.w, self.h = w, h
	self:_flush()
end

function Node:Show(b)
	if self.shown ~= b then
		self.shown = b
		self:_flush()
	end
end

function Node:SetToken(tok)
	self.token = tok
	self:_prop("Color", self.renderer.theme[tok])
end

function Node:SetFilled(b)
	self:_prop("Filled", b)
end

function Node:SetImage(data)
	self:_prop("Data", data)
end

function Node:SetText(s)
	s = tostring(s)
	if self.text == s then
		return
	end
	self.text = s
	self:_prop("Text", s)
	if self.align == "right" then
		self.lx = self.ax - self.renderer:TextWidth(s, self.size)
	end
	self:_flush()
end

local Renderer = {}
Renderer.__index = Renderer

function Renderer.new(caps, theme)
	return setmetatable({
		caps = caps,
		theme = theme,
		nodes = {},
		ox = 0,
		oy = 0,
		visible = true,
		destroyed = false,
		charRatio = 0.58,
	}, Renderer)
end

-- measures the average glyph width of the chosen font once
function Renderer:MeasureFont()
	local ok, obj = pcall(function()
		return Drawing.new("Text")
	end)
	if ok and obj then
		pcall(function()
			obj.Font = self.caps.Font
			obj.Size = 20
			obj.Text = "MMMMMMMMMMMMMMMMMMMM"
			obj.Position = Vector2.new(-3000, -3000)
			obj.Visible = true
			local b = obj.TextBounds
			if b and b.X > 0 then
				local ratio = b.X / 20 / 20
				if ratio >= 0.4 and ratio <= 0.8 then
					self.charRatio = ratio
				end
			end
		end)
		destroyDrawing(obj)
	end
end

function Renderer:TextWidth(str, size)
	return ulen(str) * size * self.charRatio
end

function Renderer:Capacity(px, size)
	return math.max(1, math.floor(px / (size * self.charRatio)))
end

function Renderer:_register(node, group)
	node.renderer = self
	node.group = group
	node.cache = {}
	node.shown = true
	table.insert(self.nodes, node)
	if group then
		table.insert(group.nodes, node)
	end
	pcall(function()
		node.obj.ZIndex = node.z
	end)
end

function Renderer:Rect(o)
	local node = setmetatable({
		obj = Drawing.new("Square"),
		kind = "Rect",
		lx = o.x or 0,
		ly = o.y or 0,
		w = o.w or 0,
		h = o.h or 0,
		token = o.token or "panel",
		absolute = o.absolute,
		z = o.z or 1,
	}, Node)
	self:_register(node, o.group)
	node:_prop("Filled", o.filled ~= false)
	node:_prop("Thickness", 1)
	node:_prop("Transparency", 1)
	node:_prop("Color", self.theme[node.token])
	node:_flush()
	return node
end

function Renderer:Label(o)
	local node = setmetatable({
		obj = Drawing.new("Text"),
		kind = "Text",
		lx = o.x or 0,
		ly = o.y or 0,
		ax = o.x or 0,
		size = o.size or 12,
		align = o.align or "left",
		token = o.token or "text",
		absolute = o.absolute,
		z = o.z or 5,
	}, Node)
	self:_register(node, o.group)
	node:_prop("Font", self.caps.Font)
	node:_prop("Size", node.size)
	node:_prop("Outline", false)
	node:_prop("Center", node.align == "center")
	node:_prop("Transparency", 1)
	node:_prop("Color", self.theme[node.token])
	node:SetText(o.text or "")
	return node
end

-- Image: Size is set to the box size exactly. Game icons are square, so a
-- square box gives a perfect fit with no stretching. Without Drawing "Image"
-- support this returns an inert stub and the UI shows initials instead.
local NOOP_NODE = setmetatable({}, { __index = function()
	return function() end
end })

function Renderer:Image(o)
	if not self.caps.Image then
		return NOOP_NODE
	end
	local node = setmetatable({
		obj = Drawing.new("Image"),
		kind = "Image",
		lx = o.x or 0,
		ly = o.y or 0,
		w = o.w or 0,
		h = o.h or 0,
		token = "text",
		absolute = o.absolute,
		z = o.z or 4,
	}, Node)
	self:_register(node, o.group)
	node:_prop("Transparency", 1)
	node.shown = false
	node:_flush()
	return node
end

function Renderer:SetOrigin(x, y)
	x, y = math.floor(x), math.floor(y)
	if x == self.ox and y == self.oy then
		return
	end
	self.ox, self.oy = x, y
	for _, n in ipairs(self.nodes) do
		n:_flush()
	end
end

function Renderer:SetVisible(b)
	if self.visible == b then
		return
	end
	self.visible = b
	for _, n in ipairs(self.nodes) do
		n:_flush()
	end
end

function Renderer:SetGroupHidden(g, hidden)
	if g.hidden == hidden then
		return
	end
	g.hidden = hidden
	local function walk(grp)
		for _, n in ipairs(grp.nodes) do
			n:_flush()
		end
		for _, c in ipairs(grp.children) do
			walk(c)
		end
	end
	walk(g)
end

function Renderer:ApplyTheme(theme)
	self.theme = theme
	for _, n in ipairs(self.nodes) do
		if n.kind ~= "Image" then
			n:_prop("Color", theme[n.token])
		end
	end
end

function Renderer:Destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	for _, n in ipairs(self.nodes) do
		destroyDrawing(n.obj)
	end
	self.nodes = {}
end

