local function clamp(v, lo, hi)
	return math.max(lo, math.min(hi, v))
end

local function trim(s)
	return (tostring(s):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function isString(v)
	return type(v) == "string" and v:match("%S") ~= nil
end

local function slugify(s)
	s = tostring(s):lower():gsub("[^%w]+", "-")
	s = s:gsub("^%-+", ""):gsub("%-+$", "")
	return s
end

local function titleCase(s)
	return (tostring(s):gsub("(%a)([%w']*)", function(a, b)
		return a:upper() .. b:lower()
	end))
end

local function cleanVersion(v)
	return (tostring(v):gsub("^[vV]", ""))
end

local function shallowCopy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
	end
	return out
end

local function ulen(s)
	return utf8.len(s) or #s
end

local function usub(s, n)
	if ulen(s) <= n then
		return s
	end
	local ok, off = pcall(utf8.offset, s, n + 1)
	if ok and off then
		return s:sub(1, off - 1)
	end
	return s:sub(1, n)
end

local function fit(s, maxChars)
	s = tostring(s)
	if ulen(s) <= maxChars then
		return s
	end
	return usub(s, math.max(0, maxChars - 2)) .. ".."
end

local function wrapText(str, maxChars, maxLines)
	maxChars = math.max(4, maxChars)
	local lines, cur = {}, ""
	for w in tostring(str):gmatch("%S+") do
		local word = w
		while ulen(word) > maxChars do
			if cur ~= "" then
				lines[#lines + 1] = cur
				cur = ""
			end
			local part = usub(word, maxChars)
			lines[#lines + 1] = part
			word = word:sub(#part + 1)
		end
		if word ~= "" then
			if cur == "" then
				cur = word
			elseif ulen(cur) + 1 + ulen(word) <= maxChars then
				cur = cur .. " " .. word
			else
				lines[#lines + 1] = cur
				cur = word
			end
		end
	end
	if cur ~= "" then
		lines[#lines + 1] = cur
	end
	if #lines > maxLines then
		for i = #lines, maxLines + 1, -1 do
			lines[i] = nil
		end
		lines[maxLines] = fit(lines[maxLines] .. "..", maxChars)
	end
	return lines
end

local function parseColor(v)
	local t = typeof(v)
	if t == "Color3" then
		return v
	end
	if t == "string" then
		local hex = v:match("^#?(%x%x%x%x%x%x)$")
		if hex then
			return Color3.fromRGB(
				tonumber(hex:sub(1, 2), 16),
				tonumber(hex:sub(3, 4), 16),
				tonumber(hex:sub(5, 6), 16)
			)
		end
	end
	return nil
end

local function viewportSize()
	local cam = Workspace.CurrentCamera
	if cam then
		return cam.ViewportSize
	end
	return Vector2.new(1280, 720)
end

local function getEnvTable()
	if type(getgenv) == "function" then
		local ok, env = pcall(getgenv)
		if ok and type(env) == "table" then
			return env
		end
	end
	return nil
end

-- Janitor: releases connections / instances / functions / threads --------
local Janitor = {}
Janitor.__index = Janitor

function Janitor.new()
	return setmetatable({ _items = {} }, Janitor)
end

function Janitor:Add(item)
	table.insert(self._items, item)
	return item
end

function Janitor:Connect(signal, fn)
	return self:Add(signal:Connect(fn))
end

function Janitor:_clean(item)
	local t = typeof(item)
	if t == "RBXScriptConnection" then
		item:Disconnect()
	elseif t == "function" then
		item()
	elseif t == "Instance" then
		item:Destroy()
	elseif t == "thread" then
		pcall(task.cancel, item)
	elseif t == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

function Janitor:Cleanup()
	local items = self._items
	self._items = {}
	for i = #items, 1, -1 do
		pcall(self._clean, self, items[i])
	end
end

----------------------------------------------------------------------
-- 2. ENVIRONMENT / CAPABILITY DETECTION
----------------------------------------------------------------------

local function destroyDrawing(obj)
	if obj == nil then
		return
	end
	if not pcall(function()
		obj:Remove()
	end) then
		pcall(function()
			obj:Destroy()
		end)
	end
end

local function probeDrawing(kind)
	local ok, obj = pcall(function()
		return Drawing.new(kind)
	end)
	if not ok or obj == nil then
		return false
	end
	pcall(function()
		obj.Visible = false
	end)
	destroyDrawing(obj)
	return true
end

local capsCache
local function getCapabilities()
	if capsCache then
		return capsCache
	end
	local caps = {
		Drawing = false,
		Square = false,
		Text = false,
		Image = false,
		Font = 3,
		FontName = "Monospace",
		GetEnv = getEnvTable() ~= nil,
	}
	local okD, D = pcall(function()
		return Drawing
	end)
	if okD and D ~= nil then
		caps.Drawing = true
		caps.Square = probeDrawing("Square")
		caps.Text = probeDrawing("Text")
		caps.Image = probeDrawing("Image")
		local okF, f = pcall(function()
			return Drawing.Fonts.Monospace
		end)
		if okF and f ~= nil then
			caps.Font = f
		end
	end
	capsCache = caps
	return caps
end

----------------------------------------------------------------------
-- 2b. THUMBNAILS  (place id -> game icon PNG bytes, cached per session)
----------------------------------------------------------------------

local HttpService = game:GetService("HttpService")

local function httpGet(url)
	local reqFn = (type(request) == "function" and request)
		or (type(http_request) == "function" and http_request)
		or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
		or (type(fluxus) == "table" and type(fluxus.request) == "function" and fluxus.request)
	if reqFn then
		local ok, res = pcall(reqFn, { Url = url, Method = "GET" })
		if ok and type(res) == "table" and type(res.Body) == "string"
			and (res.StatusCode == nil or res.StatusCode == 200) then
			return res.Body
		end
	end
	local ok, body = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and type(body) == "string" then
		return body
	end
	return nil
end

local function fetchPlaceIcon(placeId)
	local meta = httpGet(string.format(
		"https://thumbnails.roblox.com/v1/places/gameicons?placeIds=%.0f&returnPolicy=PlaceHolder&size=150x150&format=Png&isCircular=false",
		placeId
	))
	if not meta then
		return nil
	end
	local ok, json = pcall(HttpService.JSONDecode, HttpService, meta)
	local entry = ok and type(json) == "table" and type(json.data) == "table" and json.data[1]
	if not entry or entry.state ~= "Completed" or type(entry.imageUrl) ~= "string" then
		return nil
	end
	return httpGet(entry.imageUrl)
end

local Thumbs = { data = {}, state = {}, waiters = {} }

-- state[pid]: nil (never requested) | "loading" | "ready" | "failed"
function Thumbs.Request(pid, cb)
	local st = Thumbs.state[pid]
	if st == "ready" or st == "failed" then
		if cb then
			cb()
		end
		return
	end
	local w = Thumbs.waiters[pid]
	if not w then
		w = {}
		Thumbs.waiters[pid] = w
	end
	if cb then
		table.insert(w, cb)
	end
	if st == "loading" then
		return
	end
	Thumbs.state[pid] = "loading"
	task.spawn(function()
		local ok, data = pcall(fetchPlaceIcon, pid)
		if ok and type(data) == "string" and #data > 100 then
			Thumbs.data[pid] = data
			Thumbs.state[pid] = "ready"
		else
			Thumbs.state[pid] = "failed"
		end
		local list = Thumbs.waiters[pid]
		Thumbs.waiters[pid] = nil
		for _, f in ipairs(list or {}) do
			pcall(f)
		end
	end)
end

