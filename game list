-- Input -------------------------------------------------------------------
local function guarded(ui, fn)
	return function(...)
		local ok, err = pcall(fn, ...)
		if not ok and not ui.dead then
			ui.lib:_log("error", "UI: " .. tostring(err))
		end
	end
end

function UI:Bind()
	local j = self.janitor
	j:Connect(UserInputService.InputBegan, guarded(self, function(input, processed)
		self:OnInputBegan(input, processed)
	end))
	j:Connect(UserInputService.InputEnded, guarded(self, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.drag = nil
		end
	end))
	j:Connect(UserInputService.InputChanged, guarded(self, function(input)
		self:OnInputChanged(input)
	end))
	local cam = Workspace.CurrentCamera
	if cam then
		j:Connect(cam:GetPropertyChangedSignal("ViewportSize"), guarded(self, function()
			self:ClampWindow()
		end))
	end
	self._keyHandler = guarded(self, function(_, state, input)
		if state == Enum.UserInputState.Begin then
			self:OnKey(input)
		end
	end)
end

function UI:OnInputBegan(input, processed)
	if self.dead then
		return
	end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 then
		local m = UserInputService:GetMouseLocation()
		local reg = self:RegionAt(m.X, m.Y)
		self:HideTooltip()
		self:SetFocus(reg ~= nil and reg.id == "search")
		if reg then
			if reg.drag then
				self.drag = { dx = m.X - self.r.ox, dy = m.Y - self.r.oy }
			elseif reg.onClick then
				reg.onClick()
			end
		end
	elseif t == Enum.UserInputType.Keyboard and not processed and not self.focused
		and input.KeyCode == self.lib._toggleKey then
		self:SetVisible(not self.r.visible)
	end
end

function UI:OnInputChanged(input)
	if self.dead then
		return
	end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseMovement then
		local m = UserInputService:GetMouseLocation()
		if self.drag then
			local vp = viewportSize()
			local h = self.minimized and L.HEADER or L.H
			self.r:SetOrigin(
				clamp(m.X - self.drag.dx, 0, math.max(0, vp.X - L.W)),
				clamp(m.Y - self.drag.dy, 0, math.max(0, vp.Y - h))
			)
		else
			self:SetHover(self:RegionAt(m.X, m.Y))
		end
	elseif t == Enum.UserInputType.MouseWheel then
		local m = UserInputService:GetMouseLocation()
		local reg = self:RegionAt(m.X, m.Y, function(g)
			return g.onScroll ~= nil
		end)
		if reg then
			reg.onScroll(input.Position.Z > 0 and -1 or 1)
		end
	end
end

-- Search field ---------------------------------------------------------------
function UI:SetFocus(b)
	if self.focused == b then
		return
	end
	self.focused = b
	if b then
		pcall(function()
			ContextActionService:BindActionAtPriority(
				ACTION_NAME,
				function(...)
					self._keyHandler(...)
					return Enum.ContextActionResult.Sink
				end,
				false, 3000, table.unpack(SEARCH_KEYS)
			)
		end)
	else
		pcall(function()
			ContextActionService:UnbindAction(ACTION_NAME)
		end)
	end
	if not self.dead then
		self:RefreshSearch()
	end
end

function UI:OnKey(input)
	local lib = self.lib
	local kc = input.KeyCode
	if kc == Enum.KeyCode.Escape then
		if lib._query ~= "" then
			self:SetQuery("")
		else
			self:SetFocus(false)
		end
	elseif kc == Enum.KeyCode.Return then
		self:SetFocus(false)
	elseif kc == Enum.KeyCode.Backspace then
		if #lib._query > 0 then
			self:SetQuery(lib._query:sub(1, -2))
		end
	else
		local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		local ch = keyToChar(kc, shift)
		if ch and #lib._query < 32 then
			self:SetQuery(lib._query .. ch)
		end
	end
end

function UI:SetQuery(q)
	self.lib._query = q
	self:RefreshSearch()
	self.filterToken = self.filterToken + 1
	local token = self.filterToken
	task.delay(0.12, function() -- debounce
		if self.dead or self.filterToken ~= token then
			return
		end
		self.lib:_rebuildFilter()
		self.listOffset = 0
		self:RefreshList()
	end)
end

-- Window management ----------------------------------------------------------
function UI:ClampWindow()
	if self.dead then
		return
	end
	local vp = viewportSize()
	local h = self.minimized and L.HEADER or L.H
	self.r:SetOrigin(
		clamp(self.r.ox, 0, math.max(0, vp.X - L.W)),
		clamp(self.r.oy, 0, math.max(0, vp.Y - h))
	)
end

function UI:ToggleMinimize()
	self.minimized = not self.minimized
	self:SetFocus(false)
	self:HideTooltip()
	self.r:SetGroupHidden(self.groups.body, self.minimized)
	local h = self.minimized and L.HEADER or L.H
	self.frameBg:Resize(L.W, h)
	self.frameBorder:Resize(L.W, h)
	self.btnMin:SetText(self.minimized and "+" or "-")
	self:ClampWindow()
	self:ReHover()
end

function UI:SetVisible(b)
	if not b then
		self:SetFocus(false)
		self:HideTooltip()
		self.drag = nil
	end
	self.r:SetVisible(b)
	if b then
		self:ReHover()
	end
end

function UI:Show()
	self:SetVisible(true)
	if self.minimized then
		self:ToggleMinimize()
	end
end

-- Tooltip ----------------------------------------------------------------------
function UI:HideTooltip()
	self.tipToken = self.tipToken + 1
	if not self.dead then
		self.r:SetGroupHidden(self.groups.tip, true)
	end
end

function UI:UpdateTooltip()
	self:HideTooltip()
	local token = self.tipToken
	local reg = self.hover
	if not reg or not reg.tooltip then
		return
	end
	task.delay(0.45, function()
		if self.dead or self.tipToken ~= token or self.hover ~= reg or self.drag then
			return
		end
		local tip = reg.tooltip
		if type(tip) == "function" then
			tip = tip()
		end
		if type(tip) == "string" and tip ~= "" then
			self:ShowTooltip(tip)
		end
	end)
end

function UI:ShowTooltip(text)
	local r = self.r
	local m = UserInputService:GetMouseLocation()
	local vp = viewportSize()
	local w = r:TextWidth(text, 11) + 16
	local x = clamp(m.X + 14, 0, math.max(0, vp.X - w))
	local y = clamp(m.Y + 20, 0, math.max(0, vp.Y - 22))
	self.tipBg:Resize(w, 22)
	self.tipBorder:Resize(w, 22)
	self.tipBg:Move(x, y)
	self.tipBorder:Move(x, y)
	self.tipLbl:SetText(text)
	self.tipLbl:Move(x + 8, y + 5)
	r:SetGroupHidden(self.groups.tip, false)
end

-- Toasts -------------------------------------------------------------------------
function UI:PumpToasts()
	local q = self.lib._toastQueue
	for _, slot in ipairs(self.toastSlots) do
		if #q == 0 then
			break
		end
		if not slot.active then
			self:ShowToast(slot, table.remove(q, 1))
		end
	end
end

function UI:ShowToast(slot, item)
	slot.active = true
	slot.token = slot.token + 1
	local token = slot.token
	slot.title:SetText(fit(item.title, self.toastChars))
	slot.msg:SetText(fit(item.message, self.toastChars + 4))
	self.r:SetGroupHidden(slot.group, false)
	task.delay(item.duration, function()
		if not self.dead and slot.token == token then
			self:DismissToast(slot)
		end
	end)
end

function UI:DismissToast(slot)
	if not slot.active then
		return
	end
	slot.active = false
	slot.token = slot.token + 1
	self.r:SetGroupHidden(slot.group, true)
	self:PumpToasts()
	self:ReHover()
end

-- Refresh (data -> drawing properties, change-only writes) -----------------------
function UI:RefreshHeader()
	local lib, r = self.lib, self.r
	local title = fit(lib._title, 40)
	self.titleLbl:SetText(title)
	self.subtitleLbl:SetText(fit(lib._subtitle, 60))
	self.versionLbl:SetText("v" .. cleanVersion(lib._version))
	self.versionLbl:Move(14 + r:TextWidth(title, 14) + 8, 11)
	self:RefreshStatus()
	self.btnMin:SetText(self.minimized and "+" or "-")
end

function UI:RefreshStatus()
	local st = self.lib._status
	local text = fit(string.upper(st.text), 12)
	self.statusLbl:SetText(text)
	self.statusDot:Move(self.statusAnchor - self.r:TextWidth(text, 10) - 12, 20)
	local tok = st.kind == "busy" and "textDim" or "text"
	self.statusDot:SetFilled(st.kind ~= "error")
	self.statusDot:SetToken(tok)
	self.statusLbl:SetToken(tok)
end

function UI:RefreshSearch()
	local q = self.lib._query
	if q == "" and not self.focused then
		self.searchLbl:SetText("Search games...")
		self.searchLbl:SetToken("muted")
	else
		self.searchLbl:SetText(fit(q .. (self.focused and "|" or ""), self.searchChars))
		self.searchLbl:SetToken("text")
	end
	self.searchBorder:SetToken(self.focused and "textDim" or "border")
end

function UI:SetSlotShown(slot, b)
	for _, n in ipairs(slot.nodes) do
		n:Show(b)
	end
	slot.region.on = b
end

function UI:RefreshSlotVisual(slot)
	local lib = self.lib
	local g = slot.id and lib._games[slot.id]
	if not g then
		return
	end
	local selected = lib._selectedId == g.Id
	local hover = slot.hover
	local bgTok = selected and "panel2" or (hover and "hover" or "panel")
	slot.bg:SetToken(bgTok)
	slot.bar:SetToken(selected and "text" or bgTok)
	slot.box:SetToken(selected and "text" or "border")
	slot.initial:SetToken(selected and "text" or "textDim")
	local titleTok = (selected or hover) and "text" or "textDim"
	if not g.Enabled then
		titleTok = "muted"
	end
	slot.title:SetToken(titleTok)
	slot.desc:SetToken(selected and "textDim" or "muted")
	if lib._matchedId == g.Id then
		slot.dot:SetFilled(true)
		slot.dot:SetToken("text")
	elseif g.Enabled then
		slot.dot:SetFilled(true)
		slot.dot:SetToken("textDim")
	else
		slot.dot:SetFilled(false)
		slot.dot:SetToken("muted")
	end
end

local function updateScrollbar(track, thumb, top, height, offset, total, visible)
	if total <= visible then
		track:Show(false)
		thumb:Show(false)
		return
	end
	local th = math.max(16, math.floor(height * visible / total))
	local maxOff = total - visible
	local ty = top + math.floor((height - th) * (offset / maxOff))
	track:Show(true)
	thumb:Show(true)
	thumb:Resize(3, th)
	thumb:Move(thumb.lx, ty)
end

function UI:RefreshList()
	local lib = self.lib
	local list = lib._filtered
	local n = #self.slots
	local maxOff = math.max(0, #list - n)
	self.listOffset = clamp(self.listOffset, 0, maxOff)
	for i, slot in ipairs(self.slots) do
		local id = list[self.listOffset + i]
		local g = id and lib._games[id]
		if g then
			slot.id = g.Id
			slot.initial:SetText(g._initial)
			slot.title:SetText(fit(g.Title, self.rowTitleChars))
			slot.desc:SetText(fit(g.Description or "", self.rowDescChars))
			self:SetSlotShown(slot, true)
			self:ApplyThumb(slot.img, slot.initial, g)
			self:RefreshSlotVisual(slot)
		else
			slot.id = nil
			slot.hover = false
			self:SetSlotShown(slot, false)
		end
	end
	self.countLbl:SetText(#lib._order == #list and tostring(#list) or (#list .. "/" .. #lib._order))
	updateScrollbar(self.listTrack, self.listThumb, self.listY, self.listH, self.listOffset, #list, n)
	if #list == 0 then
		self.listEmpty:SetText(#lib._order == 0 and "No games registered" or "No results")
		self.listEmpty:Show(true)
	else
		self.listEmpty:Show(false)
	end
	self:ReHover()
end

function UI:RefreshWelcome()
	local lib = self.lib
	self.welcomeTitle:SetText("Welcome to " .. fit(titleCase(lib._title), 24))
	local lines = wrapText("Select a game from the library to explore its information and available features.", self.welcomeChars, 2)
	for i, node in ipairs(self.welcomeLines) do
		node:SetText(lines[i] or "")
	end
	local modules = 0
	for _, g in pairs(lib._games) do
		if g.Module and g.Enabled then
			modules = modules + 1
		end
	end
	local data = {
		{ "GAMES", tostring(#lib._order) },
		{ "MODULES", tostring(modules) },
		{ "VERSION", cleanVersion(lib._version) },
	}
	for i, card in ipairs(self.cards) do
		card.label:SetText(data[i][1])
		card.value:SetText(fit(data[i][2], 9))
	end
	local m = lib._matchedId and lib._games[lib._matchedId]
	self.placeHint:SetText(m and fit("Current place matches: " .. m.Title, self.welcomeChars) or "")
end

function UI:ApplyThumb(img, initial, g)
	local pid = g._thumbPlace
	if pid and self.caps.Image then
		local st = Thumbs.state[pid]
		if st == "ready" then
			img:SetImage(Thumbs.data[pid])
			img:Show(true)
			initial:Show(false)
			return
		elseif st == nil or (st == "loading" and not self.thumbWait[pid]) then
			self.thumbWait[pid] = true
			Thumbs.Request(pid, function()
				if not self.dead then
					self.lib:_refresh("List", "Content")
				end
			end)
		end
	end
	img:Show(false)
	initial:Show(true)
end

function UI:RefreshGame(g)
	self.gameInitial:SetText(g._initial)
	self:ApplyThumb(self.gameImg, self.gameInitial, g)
	self.gameTitle:SetText(fit(g.Title, self.gameTitleChars))
	local state = g._moduleState
	local parts = {}
	if not g.Enabled then
		parts[#parts + 1] = "UNAVAILABLE"
	elseif state == "active" or g._running then
		parts[#parts + 1] = "RUNNING"
	elseif state == "initializing" then
		parts[#parts + 1] = "STARTING"
	elseif state == "failed" then
		parts[#parts + 1] = "FAILED"
	else
		parts[#parts + 1] = "READY"
	end
	if g.Version then
		parts[#parts + 1] = "v" .. cleanVersion(g.Version)
	end
	if self.lib._matchedId == g.Id then
		parts[#parts + 1] = "CURRENT PLACE"
	end
	self.gameInfo:SetText(fit(table.concat(parts, "  |  "), self.infoChars))

	-- RUN / STOP button
	local hasScript = type(g.Run) == "function" or type(g.Module) == "table"
	local label, enabled, active = "RUN", g.Enabled and hasScript, false
	if g._running then
		label, enabled = "RUNNING", false
	elseif state == "initializing" then
		label, enabled = "STARTING", false
	elseif state == "active" then
		label, enabled, active = "STOP", g.Enabled, true
	end
	self.runBtn:SetText(label)
	self.runBtn:SetActive(active)
	self.runBtn:SetEnabled(enabled and true or false)

	local desc = (g.Description and g.Description ~= "") and g.Description or "No description provided."
	local lines = wrapText(desc, self.descChars, #self.descLines)
	for i, node in ipairs(self.descLines) do
		node:SetText(lines[i] or "")
	end
	self.featCountLbl:SetText(#g.Features .. (#g.Features == 1 and " ITEM" or " ITEMS"))
end

function UI:RefreshFeatureVisual(slot)
	local f = slot.feature
	if not f then
		return
	end
	local selected = self.selectedFeature == f.Id
	slot.bg:SetToken(selected and "panel2" or (slot.hover and "hover" or "bg"))
	slot.label:SetToken(f.Enabled and ((selected or slot.hover) and "text" or "textDim") or "muted")
end

function UI:RefreshFeatures()
	local lib = self.lib
	local g = lib._games[lib._selectedId]
	if not g then
		return
	end
	local list = g.Features
	local n = #self.featSlots
	self.featOffset = clamp(self.featOffset, 0, math.max(0, #list - n))
	for i, slot in ipairs(self.featSlots) do
		local f = list[self.featOffset + i]
		slot.feature = f
		if f then
			slot.label:SetText(fit("- " .. f.Title, self.featChars))
			for _, node in ipairs(slot.nodes) do
				node:Show(true)
			end
			slot.region.on = true
			self:RefreshFeatureVisual(slot)
		else
			slot.hover = false
			for _, node in ipairs(slot.nodes) do
				node:Show(false)
			end
			slot.region.on = false
		end
	end
	updateScrollbar(self.featTrack, self.featThumb, self.featListTop, self.featListH, self.featOffset, #list, n)
	if #list == 0 then
		self.featEmpty:SetText("No features listed for this game")
		self.featEmpty:Show(true)
	else
		self.featEmpty:Show(false)
	end
	local sel = self.selectedFeature and g._featureIndex[self.selectedFeature]
	if sel then
		self.detailLbl:SetText(fit(sel.Title .. ": " .. (sel.Description ~= "" and sel.Description or "No description"), self.detailChars))
		self.detailLbl:SetToken("textDim")
	else
		self.detailLbl:SetText("Hover or click a feature for details")
		self.detailLbl:SetToken("muted")
	end
	self:ReHover()
end

function UI:RefreshContent()
	local lib = self.lib
	local g = lib._games[lib._selectedId]
	self.r:SetGroupHidden(self.groups.welcome, g ~= nil)
	self.r:SetGroupHidden(self.groups.game, g == nil)
	if g then
		self:RefreshGame(g)
		self:RefreshFeatures()
		for _, slot in ipairs(self.slots) do
			self:RefreshSlotVisual(slot)
		end
	else
		self:RefreshWelcome()
	end
end

function UI:RefreshAll()
	self:RefreshHeader()
	self:RefreshSearch()
	self:RefreshList()
	self:RefreshContent()
end

function UI:ApplyTheme()
	self.r:ApplyTheme(self.lib._theme)
end

function UI:Destroy()
	if self.dead then
		return
	end
	self:SetFocus(false)
	self.dead = true
	self.tipToken = self.tipToken + 1
	self.filterToken = self.filterToken + 1
	self.janitor:Cleanup()
	self.r:Destroy()
	self.regions = {}
end

----------------------------------------------------------------------
-- 6. LIBRARY: REGISTRY, LIFECYCLE, PUBLIC API
----------------------------------------------------------------------

local Library = {}
Library.__index = Library

local UniversalLibrary = {}
UniversalLibrary.Version = LIB_VERSION

function UniversalLibrary.GetCapabilities()
	return shallowCopy(getCapabilities())
end

-- internal helpers ---------------------------------------------------------
-- Console-only diagnostics (no on-screen log). Consecutive duplicates are dropped
-- so a failing callback cannot flood the output.
function Library:_log(level, msg)
	msg = tostring(msg):gsub("%s+", " ")
	local key = level .. ":" .. msg
	if self._lastLog == key then
		return
	end
	self._lastLog = key
	if level == "error" or level == "warn" then
		warn(LOG_TAG, msg)
	elseif self._debug then
		print(LOG_TAG, msg)
	end
end

-- Invalid arguments: raise when Strict (default), otherwise log + return nil, msg.
function Library:_fail(method, msg)
	local full = method .. ": " .. msg
	self:_log("error", full)
	if self._strict then
		error(LOG_TAG .. " " .. full, 0)
	end
	return nil, full
end

function Library:_refresh(...)
	local ui = self._ui
	if not ui or ui.dead then
		return
	end
	for _, what in ipairs({ ... }) do
		ui["Refresh" .. what](ui)
	end
end

function Library:_setStatus(kind, text, ttl)
	self._status = { kind = kind, text = text }
	self._statusToken = self._statusToken + 1
	local token = self._statusToken
	if ttl then
		task.delay(ttl, function()
			if self._statusToken == token then
				self._status = { kind = "ready", text = "READY" }
				self:_refresh("Status")
			end
		end)
	end
	self:_refresh("Status")
end

function Library:_rebuildFilter()
	local q = self._query:lower()
	local out = {}
	for _, id in ipairs(self._order) do
		local g = self._games[id]
		if q == "" or g._search:find(q, 1, true) then
			out[#out + 1] = id
		end
	end
	self._filtered = out
end

function Library:_computeMatch()
	self._matchedId = nil
	local pid = game.PlaceId
	if not self._autoDetect or pid == 0 then
		return
	end
	for _, id in ipairs(self._order) do
		local g = self._games[id]
		if g.PlaceIds and table.find(g.PlaceIds, pid) then
			self._matchedId = id
			break
		end
	end
end

-- validation ---------------------------------------------------------------
local function normaliseFeature(def)
	if type(def) == "string" then
		def = { Title = def }
	end
	if type(def) ~= "table" then
		return nil, "a feature must be a string or a table"
	end
	if not isString(def.Title) and not isString(def.Id) then
		return nil, "a feature needs a Title or an Id"
	end
	if def.Description ~= nil and type(def.Description) ~= "string" then
		return nil, "feature Description must be a string"
	end
	local f = shallowCopy(def)
	f.Title = isString(def.Title) and trim(def.Title) or trim(def.Id)
	f.Id = isString(def.Id) and trim(def.Id) or slugify(f.Title)
	if f.Id == "" then
		return nil, "could not derive a feature id"
	end
	f.Description = def.Description or ""
	f.Enabled = def.Enabled ~= false
	return f
end

local function normalisePlaceIds(v)
	if v == nil then
		return nil
	end
	if type(v) == "number" then
		return { v }
	end
	if type(v) ~= "table" then
		return nil, "PlaceIds must be a number or a list of numbers"
	end
	local out = {}
	for _, id in ipairs(v) do
		if type(id) ~= "number" then
			return nil, "PlaceIds must contain only numbers"
		end
		out[#out + 1] = id
	end
	return out
end

-- public API -----------------------------------------------------------------
function UniversalLibrary.new(config)
	if config ~= nil and type(config) ~= "table" then
		error(LOG_TAG .. " new: config must be a table", 2)
	end
	config = config or {}
	local self = setmetatable({}, Library)
	self._title = isString(config.Title) and config.Title or "UNIVERSAL"
	self._subtitle = isString(config.Subtitle) and config.Subtitle or "GAME SCRIPT LIBRARY"
	self._version = config.Version ~= nil and tostring(config.Version) or LIB_VERSION
	self._strict = config.Strict ~= false
	self._debug = config.Debug == true
	self._autoDetect = config.AutoDetect ~= false
	self._autoSelect = config.AutoSelect == true
	self._singleInstance = config.SingleInstance ~= false
	self._toggleKey = typeof(config.ToggleKey) == "EnumItem" and config.ToggleKey or Enum.KeyCode.RightShift
	self._position = typeof(config.Position) == "Vector2" and config.Position or nil
	self._games, self._order, self._filtered = {}, {}, {}
	self._selectedId, self._matchedId = nil, nil
	self._query = ""
	self._logs = {}
	self._toastQueue = {}
	self._status = { kind = "ready", text = "READY" }
	self._statusToken = 0
	self._themeName, self._themeOverrides = "Monochrome", {}
	self._theme = resolveTheme("Monochrome", {})
	self._ui = nil
	if config.Theme ~= nil then
		self:SetTheme(config.Theme)
	end
	return self
end

function Library:SetTitle(title)
	if not isString(title) then
		return self:_fail("SetTitle", "title must be a non-empty string")
	end
	self._title = title
	self:_refresh("Header", "Content")
	return self
end

function Library:SetSubtitle(subtitle)
	if type(subtitle) ~= "string" then
		return self:_fail("SetSubtitle", "subtitle must be a string")
	end
	self._subtitle = subtitle
	self:_refresh("Header")
	return self
end

function Library:SetTheme(config)
	local name = self._themeName
	local overrides = shallowCopy(self._themeOverrides)
	if type(config) == "string" then
		name, overrides = config, {}
	elseif type(config) == "table" then
		if config.Name ~= nil then
			name = config.Name
		end
		local colors = type(config.Colors) == "table" and config.Colors or config
		for k, v in pairs(colors) do
			if type(k) == "string" and k ~= "Name" and k ~= "Colors" then
				local token = THEME_LOOKUP[k:lower()]
				if not token then
					return self:_fail("SetTheme", "unknown theme key '" .. k .. "'")
				end
				local c = parseColor(v)
				if not c then
					return self:_fail("SetTheme", "invalid colour for '" .. k .. "' (use Color3 or \"#RRGGBB\")")
				end
				overrides[token] = c
			end
		end
	else
		return self:_fail("SetTheme", "expected a theme name or a table")
	end
	if not Themes[name] then
		return self:_fail("SetTheme", "unknown theme '" .. tostring(name) .. "'")
	end
	self._themeName, self._themeOverrides = name, overrides
	self._theme = resolveTheme(name, overrides)
	if self._ui and not self._ui.dead then
		self._ui:ApplyTheme()
	end
	return self
end

function Library:GetGame(id)
	return type(id) == "string" and self._games[id] or nil
end

function Library:AddGame(config)
	if type(config) ~= "table" then
		return self:_fail("AddGame", "config must be a table")
	end
	local title = isString(config.Title) and trim(config.Title) or (isString(config.Id) and trim(config.Id) or nil)
	if not title then
		return self:_fail("AddGame", "a Title (or Id) is required")
	end
	local id
	if config.Id ~= nil then
		if not isString(config.Id) then
			return self:_fail("AddGame", "Id must be a non-empty string")
		end
		id = trim(config.Id)
	else
		id = slugify(title)
		if id == "" then
			return self:_fail("AddGame", "could not generate an Id from the Title; supply one")
		end
	end
	if self._games[id] then
		return self:_fail("AddGame", "duplicate game id '" .. id .. "'")
	end
	if config.Description ~= nil and type(config.Description) ~= "string" then
		return self:_fail("AddGame", "Description must be a string")
	end
	if config.Callback ~= nil and type(config.Callback) ~= "function" then
		return self:_fail("AddGame", "Callback must be a function")
	end
	if config.Run ~= nil and type(config.Run) ~= "function" then
		return self:_fail("AddGame", "Run must be a function")
	end
	if config.Icon ~= nil and type(config.Icon) ~= "string" then
		return self:_fail("AddGame", "Icon must be a string")
	end
	local placeIds, perr = normalisePlaceIds(config.PlaceIds or config.PlaceId)
	if perr then
		return self:_fail("AddGame", perr)
	end
	local mod = config.Module
	if mod ~= nil then
		if type(mod) ~= "table" then
			return self:_fail("AddGame", "Module must be a table")
		end
		if mod.Initialize ~= nil and type(mod.Initialize) ~= "function" then
			return self:_fail("AddGame", "Module.Initialize must be a function")
		end
		if mod.Cleanup ~= nil and type(mod.Cleanup) ~= "function" then
			return self:_fail("AddGame", "Module.Cleanup must be a function")
		end
	end
	if config.Features ~= nil and type(config.Features) ~= "table" then
		return self:_fail("AddGame", "Features must be a list")
	end

	local g = shallowCopy(config)
	g.Id, g.Title = id, title
	g.Description = config.Description or ""
	g.Enabled = config.Enabled ~= false
	g.PlaceIds = placeIds
	g.Version = config.Version ~= nil and tostring(config.Version) or (mod and mod.Version ~= nil and tostring(mod.Version)) or nil
	g.Settings = config.Settings or (mod and mod.Settings) or {}
	g.Features, g._featureIndex = {}, {}
	g._initial = (config.Icon and #config.Icon > 0 and #config.Icon <= 3) and config.Icon
		or (title:match("%w") or "?"):upper()
	g._search = (title .. " " .. id .. " " .. g.Description):lower()
	g._moduleState = mod and "idle" or "none"
	g._running = false
	local thumbId = tonumber(config.IconPlaceId) or (placeIds and placeIds[1])
	g._thumbPlace = thumbId and math.floor(thumbId) or nil

	local defs = {}
	for _, d in ipairs(config.Features or {}) do
		defs[#defs + 1] = d
	end
	if mod and type(mod.Features) == "table" then
		for _, d in ipairs(mod.Features) do
			defs[#defs + 1] = d
		end
	end
	for _, d in ipairs(defs) do
		local f, err = normaliseFeature(d)
		if not f then
			return self:_fail("AddGame", "game '" .. id .. "': " .. err)
		end
		if g._featureIndex[f.Id] then
			return self:_fail("AddGame", "game '" .. id .. "': duplicate feature id '" .. f.Id .. "'")
		end
		g._featureIndex[f.Id] = f
		g.Features[#g.Features + 1] = f
	end

	self._games[id] = g
	self._order[#self._order + 1] = id
	self:_rebuildFilter()
	self:_computeMatch()
	self:_log("info", "Registered " .. title)
	self:_refresh("List", "Content")
	return g
end

function Library:RemoveGame(id)
	local g = type(id) == "string" and self._games[id] or nil
	if not g then
		self:_log("warn", "RemoveGame: unknown game '" .. tostring(id) .. "'")
		return false
	end
	if self._selectedId == id then
		self:SelectGame(nil)
	end
	self:_stopModule(g)
	self._games[id] = nil
	local idx = table.find(self._order, id)
	if idx then
		table.remove(self._order, idx)
	end
	self:_rebuildFilter()
	self:_computeMatch()
	self:_log("info", "Removed " .. g.Title)
	self:_refresh("List", "Content")
	return true
end

function Library:AddFeature(gameId, feature)
	local g = type(gameId) == "string" and self._games[gameId] or nil
	if not g then
		return self:_fail("AddFeature", "unknown game '" .. tostring(gameId) .. "'")
	end
	local f, err = normaliseFeature(feature)
	if not f then
		return self:_fail("AddFeature", err)
	end
	if g._featureIndex[f.Id] then
		return self:_fail("AddFeature", "duplicate feature id '" .. f.Id .. "' for game '" .. gameId .. "'")
	end
	g._featureIndex[f.Id] = f
	g.Features[#g.Features + 1] = f
	if self._selectedId == gameId then
		self:_refresh("Content")
	end
	return f
end

function Library:Notify(config)
	if type(config) == "string" then
		config = { Message = config }
	end
	if type(config) ~= "table" then
		return self:_fail("Notify", "expected a string or a table")
	end
	local item = {
		title = isString(config.Title) and config.Title or self._title,
		message = tostring(config.Message or config.Text or config.Content or ""),
		duration = clamp(tonumber(config.Duration) or 3, 1, 15),
	}
	self:_log("info", item.title .. ": " .. item.message)
	local ui = self._ui
	if ui and not ui.dead then
		if #self._toastQueue < 20 then
			table.insert(self._toastQueue, item)
		end
		ui:PumpToasts()
	end
	return true
end

function Library:SetVisible(b)
	if self._ui and not self._ui.dead then
		self._ui:SetVisible(b == true)
	end
end

-- module lifecycle -------------------------------------------------------------
function Library:_makeContext(g, janitor)
	return {
		Library = self,
		Game = g,
		Janitor = janitor,
		Settings = g.Settings,
		PlaceId = game.PlaceId,
		Log = function(msg, level)
			self:_log(level or "info", msg)
		end,
		Notify = function(cfg)
			self:Notify(cfg)
		end,
		IsActive = function()
			return g._janitor == janitor
		end,
	}
end

function Library:_startModule(g, onReady)
	local mod = g.Module
	if type(mod) ~= "table" then
		g._moduleState = "none"
		return
	end
	if g._moduleState == "initializing" or g._moduleState == "active" then
		return
	end
	local token = {}
	local janitor = Janitor.new()
	g._token, g._janitor = token, janitor
	g._moduleState = "initializing"
	self:_setStatus("busy", "BUSY") -- set before spawning: Initialize may finish synchronously
	task.spawn(function()
		local ok, err = true, nil
		if type(mod.Initialize) == "function" then
			ok, err = pcall(mod.Initialize, self:_makeContext(g, janitor))
		end
		if g._token ~= token then
			-- selection moved on while Initialize was running
			if ok and type(mod.Cleanup) == "function" then
				pcall(mod.Cleanup)
			end
			janitor:Cleanup()
			return
		end
		if ok then
			g._moduleState = "active"
			self:_log("ok", g.Title .. " module ready")
			self:_setStatus("ready", "READY")
			if onReady then
				task.spawn(onReady)
			end
		else
			g._moduleState = "failed"
			janitor:Cleanup()
			g._janitor = nil
			self:_log("error", g.Title .. " module failed: " .. tostring(err))
			self:Notify({ Title = g.Title, Message = "Module failed: " .. tostring(err) })
			self:_setStatus("error", "ERROR", 4)
		end
		if self._selectedId == g.Id then
			self:_refresh("Content")
		end
	end)
end

function Library:_stopModule(g)
	local state = g._moduleState
	g._token = nil -- invalidates a pending Initialize
	if state == "active" and type(g.Module) == "table" and type(g.Module.Cleanup) == "function" then
		local ok, err = pcall(g.Module.Cleanup)
		if not ok then
			self:_log("error", g.Title .. " cleanup failed: " .. tostring(err))
		end
	end
	if g._janitor then
		g._janitor:Cleanup()
		g._janitor = nil
	end
	g._moduleState = g.Module and "idle" or "none"
	-- features that were mid-run keep their own pcall; reset toggles that depended on the module
end

function Library:SelectGame(id)
	if id ~= nil and type(id) ~= "string" then
		return self:_fail("SelectGame", "id must be a string or nil")
	end
	local g
	if id ~= nil then
		g = self._games[id]
		if not g then
			self:_log("warn", "SelectGame: unknown game '" .. id .. "'")
			return false, "unknown game"
		end
	end
	if self._selectedId == id then
		return true
	end
	local prev = self._games[self._selectedId]
	if prev then
		self:_stopModule(prev)
	end
	self._selectedId = id
	if self._ui and not self._ui.dead then
		self._ui.featOffset = 0
		self._ui.selectedFeature = nil
	end
	self:_refresh("List", "Content")
	if g then
		if g.Enabled then
			self:_log("info", "Selected " .. g.Title)
			if type(g.Callback) == "function" then
				task.spawn(function()
					local ok, err = pcall(g.Callback, g)
					if not ok then
						self:_log("error", g.Title .. " callback failed: " .. tostring(err))
						self:_setStatus("error", "ERROR", 4)
					end
				end)
			end
		else
			self:_log("warn", g.Title .. " is currently unavailable")
		end
	end
	return true
end

-- RUN / STOP button. Selecting a game never starts anything; only this does.
function Library:_runGame(g)
	if not g.Enabled then
		self:Notify({ Title = g.Title, Message = "This game is currently unavailable" })
		return
	end
	if g._running or g._moduleState == "initializing" then
		return
	end
	if g._moduleState == "active" then -- STOP
		self:_stopModule(g)
		self:_setStatus("ready", "READY")
		self:_refresh("Content")
		return
	end
	local hasRun = type(g.Run) == "function"
	if not hasRun and type(g.Module) ~= "table" then
		self:Notify({ Title = g.Title, Message = "No script is attached to this game" })
		return
	end
	local function execute()
		if not hasRun then
			return
		end
		task.spawn(function()
			g._running = true
			self:_setStatus("busy", "BUSY")
			self:_refresh("Content")
			local ok, err = pcall(g.Run, g)
			g._running = false
			if ok then
				self:_setStatus("ready", "READY")
			else
				self:_log("error", g.Title .. " Run failed: " .. tostring(err))
				self:Notify({ Title = g.Title, Message = "Run failed: " .. tostring(err) })
				self:_setStatus("error", "ERROR", 4)
			end
			if self._selectedId == g.Id then
				self:_refresh("Content")
			end
		end)
	end
	if type(g.Module) == "table" then
		self:_startModule(g, execute)
	else
		execute()
	end
	self:_refresh("Content")
end

function Library:RunGame(id)
	local g = self:GetGame(id)
	if not g then
		self:_log("warn", "RunGame: unknown game '" .. tostring(id) .. "'")
		return false
	end
	self:_runGame(g)
	return true
end

-- init / destroy ------------------------------------------------------------------
function Library:Init()
	if self._ui and not self._ui.dead then
		self._ui:Show()
		return true
	end
	local caps = getCapabilities()
	if not (caps.Drawing and caps.Square and caps.Text) then
		local missing = {}
		if not caps.Drawing then
			missing[#missing + 1] = "Drawing library"
		end
		if not caps.Square then
			missing[#missing + 1] = "Drawing.new(\"Square\")"
		end
		if not caps.Text then
			missing[#missing + 1] = "Drawing.new(\"Text\")"
		end
		local msg = "Unsupported environment, missing: " .. table.concat(missing, ", ")
			.. ". The Drawing API is executor-specific and is not available in standard Roblox scripts."
		self:_log("error", msg)
		return false, msg
	end

	local env = getEnvTable()
	if env and self._singleInstance then
		local prev = env.__UniversalLibraryInstance
		if prev and prev ~= self and type(prev.Destroy) == "function" then
			pcall(prev.Destroy, prev)
		end
		env.__UniversalLibraryInstance = self
	end

	local ui = UI.new(self, caps)
	local ok, err = pcall(function()
		ui:Build()
		ui:Bind()
	end)
	if not ok then
		ui:Destroy() -- never leave a partial window behind
		self:_log("error", "Init failed: " .. tostring(err))
		return false, tostring(err)
	end
	self._ui = ui
	self:_rebuildFilter()
	self:_computeMatch()
	ui:RefreshAll()
	self:_log("ok", "Initialised v" .. cleanVersion(self._version))
	if self._autoSelect and self._matchedId then
		self:SelectGame(self._matchedId)
	end
	return true
end

function Library:Destroy(clearRegistry)
	if self._destroying then
		return
	end
	self._destroying = true
	for _, g in pairs(self._games) do
		self:_stopModule(g)
	end
	self._selectedId = nil
	self._toastQueue = {}
	self._statusToken = self._statusToken + 1
	self._status = { kind = "ready", text = "READY" }
	local ui = self._ui
	self._ui = nil
	if ui then
		ui:Destroy()
	end
	local env = getEnvTable()
	if env and env.__UniversalLibraryInstance == self then
		env.__UniversalLibraryInstance = nil
	end
	if clearRegistry == true then
		self._games, self._order, self._filtered = {}, {}, {}
		self._matchedId = nil
	end
	self._destroying = false
end

return UniversalLibrary
