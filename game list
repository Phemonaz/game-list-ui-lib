local function clamp(v, lo, hi)
	return math.max(lo, math.min(hi, v))
end

local function trim(s)
	return (tostring(s):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function isString(v)
	return type(v) == "string" and v:match("%S") ~= nil
end

local function slugify(s)
	s = tostring(s):lower():gsub("[^%w]+", "-")
	s = s:gsub("^%-+", ""):gsub("%-+$", "")
	return s
end

local function titleCase(s)
	return (tostring(s):gsub("(%a)([%w']*)", function(a, b)
		return a:upper() .. b:lower()
	end))
end

local function cleanVersion(v)
	return (tostring(v):gsub("^[vV]", ""))
end

local function shallowCopy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
	end
	return out
end

local function ulen(s)
	return utf8.len(s) or #s
end

local function usub(s, n)
	if ulen(s) <= n then
		return s
	end
	local ok, off = pcall(utf8.offset, s, n + 1)
	if ok and off then
		return s:sub(1, off - 1)
	end
	return s:sub(1, n)
end

local function fit(s, maxChars)
	s = tostring(s)
	if ulen(s) <= maxChars then
		return s
	end
	return usub(s, math.max(0, maxChars - 2)) .. ".."
end

local function wrapText(str, maxChars, maxLines)
	maxChars = math.max(4, maxChars)
	local lines, cur = {}, ""
	for w in tostring(str):gmatch("%S+") do
		local word = w
		while ulen(word) > maxChars do
			if cur ~= "" then
				lines[#lines + 1] = cur
				cur = ""
			end
			local part = usub(word, maxChars)
			lines[#lines + 1] = part
			word = word:sub(#part + 1)
		end
		if word ~= "" then
			if cur == "" then
				cur = word
			elseif ulen(cur) + 1 + ulen(word) <= maxChars then
				cur = cur .. " " .. word
			else
				lines[#lines + 1] = cur
				cur = word
			end
		end
	end
	if cur ~= "" then
		lines[#lines + 1] = cur
	end
	if #lines > maxLines then
		for i = #lines, maxLines + 1, -1 do
			lines[i] = nil
		end
		lines[maxLines] = fit(lines[maxLines] .. "..", maxChars)
	end
	return lines
end

local function parseColor(v)
	local t = typeof(v)
	if t == "Color3" then
		return v
	end
	if t == "string" then
		local hex = v:match("^#?(%x%x%x%x%x%x)$")
		if hex then
			return Color3.fromRGB(
				tonumber(hex:sub(1, 2), 16),
				tonumber(hex:sub(3, 4), 16),
				tonumber(hex:sub(5, 6), 16)
			)
		end
	end
	return nil
end

local function viewportSize()
	local cam = Workspace.CurrentCamera
	if cam then
		return cam.ViewportSize
	end
	return Vector2.new(1280, 720)
end

local function getEnvTable()
	if type(getgenv) == "function" then
		local ok, env = pcall(getgenv)
		if ok and type(env) == "table" then
			return env
		end
	end
	return nil
end

-- Janitor: releases connections / instances / functions / threads --------
local Janitor = {}
Janitor.__index = Janitor

function Janitor.new()
	return setmetatable({ _items = {} }, Janitor)
end

function Janitor:Add(item)
	table.insert(self._items, item)
	return item
end

function Janitor:Connect(signal, fn)
	return self:Add(signal:Connect(fn))
end

function Janitor:_clean(item)
	local t = typeof(item)
	if t == "RBXScriptConnection" then
		item:Disconnect()
	elseif t == "function" then
		item()
	elseif t == "Instance" then
		item:Destroy()
	elseif t == "thread" then
		pcall(task.cancel, item)
	elseif t == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

function Janitor:Cleanup()
	local items = self._items
	self._items = {}
	for i = #items, 1, -1 do
		pcall(self._clean, self, items[i])
	end
end

