	Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9",
}

local SEARCH_KEYS = {}
for c in ("ABCDEFGHIJKLMNOPQRSTUVWXYZ"):gmatch(".") do
	table.insert(SEARCH_KEYS, Enum.KeyCode[c])
end
for name in pairs(DIGITS) do
	table.insert(SEARCH_KEYS, Enum.KeyCode[name])
end
for _, name in ipairs({ "Space", "Backspace", "Return", "Escape", "Minus", "Period" }) do
	table.insert(SEARCH_KEYS, Enum.KeyCode[name])
end

local function keyToChar(kc, shift)
	if kc == Enum.KeyCode.Space then
		return " "
	elseif kc == Enum.KeyCode.Minus then
		return shift and "_" or "-"
	elseif kc == Enum.KeyCode.Period then
		return "."
	end
	local name = kc.Name
	if #name == 1 and name:match("%a") then
		return shift and name:upper() or name:lower()
	end
	return DIGITS[name]
end

local UI = {}
UI.__index = UI

function UI.new(lib, caps)
	local self = setmetatable({}, UI)
	self.lib, self.caps = lib, caps
	self.janitor = Janitor.new()
	self.regions, self.slots, self.featSlots, self.toastSlots = {}, {}, {}, {}
	self.descLines, self.cards = {}, {}
	self.thumbWait = {}
	self.selectedFeature = nil
	self.welcomeLines = {}
	self.listOffset, self.featOffset = 0, 0
	self.tipToken, self.filterToken = 0, 0
	self.minimized, self.focused, self.dead = false, false, false
	self.r = Renderer.new(caps, lib._theme)
	self.r:MeasureFont()
	local vp = viewportSize()
	local pos = lib._position
	local x = pos and pos.X or (vp.X - L.W) / 2
	local y = pos and pos.Y or (vp.Y - L.H) / 2
	self.r.ox = clamp(math.floor(x), 0, math.max(0, vp.X - L.W))
	self.r.oy = clamp(math.floor(y), 0, math.max(0, vp.Y - L.H))
	return self
end

-- Regions: input hit-boxes in window-local coordinates -------------------
function UI:AddRegion(o)
	local reg = {
		id = o.id, x = o.x, y = o.y, w = o.w, h = o.h, group = o.group,
		z = o.z or 1, on = o.on ~= false, drag = o.drag,
		onClick = o.onClick, onEnter = o.onEnter, onLeave = o.onLeave,
		onScroll = o.onScroll, tooltip = o.tooltip,
	}
	table.insert(self.regions, reg)
	return reg
end

function UI:RegionAt(px, py, pred)
	if not self.r.visible then
		return nil
	end
	local lx, ly = px - self.r.ox, py - self.r.oy
	local best
	for _, g in ipairs(self.regions) do
		if g.on and lx >= g.x and lx < g.x + g.w and ly >= g.y and ly < g.y + g.h
			and (not pred or pred(g)) and not groupHidden(g.group) then
			if not best or g.z >= best.z then
				best = g
			end
		end
	end
	return best
end

function UI:SetHover(reg)
	if reg == self.hover then
		return
	end
	local old = self.hover
	self.hover = reg
	if old and old.onLeave then
		old.onLeave()
	end
	if reg and reg.onEnter then
		reg.onEnter()
	end
	self:UpdateTooltip()
end

function UI:ReHover()
	if self.dead or self.drag then
		return
	end
	local m = UserInputService:GetMouseLocation()
	self:SetHover(self:RegionAt(m.X, m.Y))
end

-- Button component -------------------------------------------------------
function UI:Button(o)
	local r = self.r
	local size = o.size or 11
	local b = { enabled = true, hover = false, active = false }
	b.bg = r:Rect({ x = o.x, y = o.y, w = o.w, h = o.h, token = "panel2", group = o.group, z = o.z })
	b.border = r:Rect({ x = o.x, y = o.y, w = o.w, h = o.h, filled = false, token = "border", group = o.group, z = o.z + 1 })
	b.label = r:Label({
		x = o.x + o.w / 2, y = o.y + math.floor((o.h - size) / 2) - 1, size = size,
		align = "center", token = "text", group = o.group, z = o.z + 2, text = o.text or "",
	})
	b.region = self:AddRegion({
		x = o.x, y = o.y, w = o.w, h = o.h, group = o.group, z = o.z, tooltip = o.tooltip,
		onClick = function()
			if b.enabled and o.onClick then
				o.onClick(b)
			end
		end,
		onEnter = function()
			b.hover = true
			b:Refresh()
		end,
		onLeave = function()
			b.hover = false
			b:Refresh()
		end,
	})
	function b:Refresh()
		local hot = self.hover and self.enabled
		if self.active then
			self.bg:SetToken("text")
			self.border:SetToken("text")
			self.label:SetToken("bg")
		else
			self.bg:SetToken(hot and "hover" or "panel2")
			self.border:SetToken(hot and "textDim" or "border")
			self.label:SetToken(self.enabled and "text" or "muted")
		end
	end
	function b:SetText(s)
		self.label:SetText(s)
	end
	function b:SetEnabled(e)
		self.enabled = e
		self:Refresh()
	end
	function b:SetActive(a)
		self.active = a
		self:Refresh()
	end
	function b:Show(s)
		self.bg:Show(s)
		self.border:Show(s)
		self.label:Show(s)
		self.region.on = s
	end
	return b
end

