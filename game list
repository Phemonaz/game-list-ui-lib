local function destroyDrawing(obj)
	if obj == nil then
		return
	end
	if not pcall(function()
		obj:Remove()
	end) then
		pcall(function()
			obj:Destroy()
		end)
	end
end

local function probeDrawing(kind)
	local ok, obj = pcall(function()
		return Drawing.new(kind)
	end)
	if not ok or obj == nil then
		return false
	end
	pcall(function()
		obj.Visible = false
	end)
	destroyDrawing(obj)
	return true
end

local capsCache
local function getCapabilities()
	if capsCache then
		return capsCache
	end
	local caps = {
		Drawing = false,
		Square = false,
		Text = false,
		Image = false,
		Font = 3,
		FontName = "Monospace",
		GetEnv = getEnvTable() ~= nil,
	}
	local okD, D = pcall(function()
		return Drawing
	end)
	if okD and D ~= nil then
		caps.Drawing = true
		caps.Square = probeDrawing("Square")
		caps.Text = probeDrawing("Text")
		caps.Image = probeDrawing("Image")
		local okF, f = pcall(function()
			return Drawing.Fonts.Monospace
		end)
		if okF and f ~= nil then
			caps.Font = f
		end
	end
	capsCache = caps
	return caps
end

